{
  "name": "@flipbook-md/studio",
  "version": "0.3.2",
  "private": true,
  "description": "Self-hosted editor for Flipbook MD decks, themes, templates, blueprints and media kits.",
  "license": "MIT",
  "author": "Celo (https://github.com/uminocelo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlipbookMD-HQ/flipbook-studio.git"
  },
  "type": "module",
  "bin": {
    "flipbook-studio": "./bin/flipbook-studio.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && tsup",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@flipbook-md/core": "~0.14.1",
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "mammoth": "^1.13.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/merge": "6.12.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tanstack/react-query": "^5.108.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "codemirror": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
